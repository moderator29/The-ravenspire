# ============================================================
# RAVENSPIRE environment variables
# Copy to .env.local and fill in. NEXT_PUBLIC_ vars are exposed
# to the browser; everything else stays server-side only.
# ============================================================

# --- The Archives: Supabase (required, have it) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- The Raven's Mind: Anthropic (required, have it) ---
ANTHROPIC_API_KEY=

# --- The Gatehouse: auth and wallets ---
# Privy (privy.io, free tier): embedded non-custodial wallets + X login
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# X / Twitter OAuth app (developer.x.com, free tier)
X_CLIENT_ID=
X_CLIENT_SECRET=
# WalletConnect / Reown project (cloud.reown.com, free)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- EVM Sight: chain data ---
# Alchemy (alchemy.com, free tier): ETH + L2 RPC and data
ALCHEMY_API_KEY=
# Helius (helius.dev, free tier): Solana
HELIUS_API_KEY=

# --- Market Sight: prices and markets ---
# Birdeye (birdeye.so, free tier)
BIRDEYE_API_KEY=
# CoinGecko demo key (coingecko.com, free)
COINGECKO_API_KEY=
# DexScreener and GeckoTerminal are keyless, nothing needed

# --- Portfolio: GoldRush / Covalent (goldrush.dev, free tier) ---
GOLDRUSH_API_KEY=

# --- The Exchange: in-app trading + swap (EVM only, non-custodial) ---
# 0x Swap API (0x.org): quotes + calldata for buy/sell/swap. Server-side only.
ZEROX_API_KEY=
# TREASURY FEE (EVM): the realm's own EVM wallet (0x...) that collects the fee
# on every in-app buy, sell and swap. 0x routes the fee on-chain straight to
# this address. Use a wallet the realm controls (a Safe or an owned wallet).
# Absent or malformed, trades execute with NO fee attached (never misrouted).
TREASURY_FEE_EVM=
# Fee amount in BASIS POINTS (public). 50 = 0.5%, 25 = 0.25%, 5 = 0.05%.
# Defaults to 50 (0.5%) when unset. Drives both the on-chain fee and the UI.
NEXT_PUBLIC_TREASURY_FEE_BPS=50
# MoonPay on-ramp (moonpay.com): "Top up with card". Publishable key is exposed
# to the browser; the secret signs the widget URL server-side.
NEXT_PUBLIC_MOONPAY_KEY=
MOONPAY_SECRET_KEY=

# --- The Watch: token safety ---
# GoPlus Security (gopluslabs.io, free tier)
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# honeypot.is is keyless, nothing needed

# --- The Rookery: live audio and video ---
# LiveKit Cloud (livekit.io, free tier)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Ravens: notifications ---
# Telegram bot via @BotFather (free)
TELEGRAM_BOT_TOKEN=
# Resend transactional email (resend.com, free tier)
RESEND_API_KEY=

# --- The Ownership Loop: the mint (founder-only, all absent until launch) ---
# Nothing on-chain is retractable, so every one of these stays empty until the
# founder deploys the contracts and the set is final. With any of them missing
# the claim routes answer honestly that the mint is not open, and the realm
# behaves exactly as it does today. Absent is a safe, working state.
# The chain to mint on: 8453 (Base) or 84532 (Base Sepolia) for a rehearsal.
MINT_CHAIN_ID=
# The transferable ERC-1155 that holds the cards.
MINT_CARD_CONTRACT=
# The soulbound contract that holds the crests. Separate on purpose: a contract
# that can be told not to transfer can also be told to.
MINT_CREST_CONTRACT=
# The key that signs claim vouchers. Server-side only, never logged, never in a
# response. Whoever holds it can authorise a mint, so it belongs in a secret
# store and nowhere else.
MINT_VOUCHER_SIGNER_KEY=
# Optional. An explicit RPC wins over the Alchemy key above. A rate-limited
# public endpoint is deliberately NOT a fallback: reading a receipt off one is
# how a confirmed mint gets told it did not happen.
MINT_RPC_URL=
